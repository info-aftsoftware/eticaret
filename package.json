{
  "name": "voltekno",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma db push && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "audit:site": "node scripts/audit-site.mjs",
    "audit:product-ld": "node scripts/audit-product-ld.mjs",
    "i18n:sync": "node scripts/sync-i18n.mjs",
    "qa:all": "npm run typecheck && npm run lint -- --no-cache && npm run audit:site",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "npx playwright install chromium && npx playwright test tests/smoke.spec.ts --project=chromium --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build:hostinger": "next build && echo 'Build completed! Upload .next/standalone folder to Hostinger'",
    "build:static": "set STATIC_EXPORT=true && next build",
    "build:hostinger:static": "node scripts/build-hostinger-static.js",
    "prepare:hostinger": "npm run build:hostinger && node scripts/prepare-hostinger.js",
    "prepare:static": "npm run build:static && node scripts/prepare-hostinger.js",
    "deploy:hostinger": "npm run prepare:hostinger",
    "deploy:static": "npm run prepare:static",
    "public-html": "node scripts/build-public-html.js",
    "generate:categories": "tsx scripts/generate-categories-json.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "reindex:search": "tsx scripts/reindex-search.ts",
    "import:products": "python scripts/import-ikas-excel.py",
    "catalog:en": "tsx scripts/catalog-en.ts",
    "images:optimize": "node scripts/optimize-product-images.mjs",
    "catalog:cleanup-db": "tsx scripts/clear-legacy-catalog.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^0.5.6",
    "@react-email/render": "^1.3.2",
    "@react-pdf/renderer": "^4.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "googleapis": "^171.4.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.1.2",
    "postcss": "^8.5.30",
    "prisma": "^6.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.65.0",
    "resend": "^6.33.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.2",
    "@types/prop-types": "^15.7.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.28",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "deepmerge-ts": "^8.0.2",
    "@grpc/grpc-js": "^1.14.6"
  }
}
