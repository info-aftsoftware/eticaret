# ─────────────────────────────────────────────────────────────────────────────
# Voltekno — ortam değişkenleri örneği
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun. Gerçek değerleri git'e eklemeyin.
# (zorunlu) = tanımlı değilse ilgili özellik çalışmaz
# ─────────────────────────────────────────────────────────────────────────────

# Site adresi (e-postalardaki bağlantılar, ödeme dönüş adresleri, JSON-LD) (zorunlu)
NEXT_PUBLIC_SITE_URL=https://voltekno.com
# Test/geçici alan adında "true" yapın: robots.txt tüm siteyi kapatır, sayfalar noindex olur (canlıda boş bırakın)
NEXT_PUBLIC_NOINDEX=
NEXT_PUBLIC_BASE_URL=https://voltekno.com

# Veritabanı (Prisma). Geliştirme: SQLite. Canlı: PostgreSQL önerilir. (zorunlu)
DATABASE_URL="file:./dev.db"

# Firebase istemci — üye girişi, profil, adresler, favoriler (zorunlu)
# Firebase Console > Proje ayarları > Genel > Uygulamanız
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Analytics (isteğe bağlı; yalnızca çerez onayı verilirse başlar)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Meta (Facebook) Pixel kimliği (isteğe bağlı). Tanımlıysa çerez onayı veren ziyaretçilerde ViewContent, AddToCart,
# InitiateCheckout, AddPaymentInfo ve Purchase olayları gönderilir.
NEXT_PUBLIC_META_PIXEL_ID=

# Firebase Admin — sunucuda üye token doğrulama, kupon/yorum/soru okuma (zorunlu)
# Service Account JSON: project_id, client_email, private_key (satır sonları \n olarak)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Oturum imzalama anahtarı — admin oturumu ve backend JWT (zorunlu, uzun rastgele değer)
JWT_SECRET=
# Admin paneli giriş şifresi (/admin) (zorunlu, güçlü bir şifre)
ADMIN_TOKEN=
# Admin iki adımlı doğrulama (isteğe bağlı, önerilir): `node scripts/admin-2fa-setup.mjs` çıktısındaki anahtar.
# Tanımlıysa girişte şifreye ek olarak doğrulama uygulamasındaki 6 haneli kod istenir.
ADMIN_TOTP_SECRET=
# Son canlı döviz kurunun yazılacağı dosya (isteğe bağlı; varsayılan .data/fx-rates.json)
FX_CACHE_FILE=
# Yeni sipariş / ödeme bildirimlerinin gideceği adres
ADMIN_EMAIL=info@voltekno.com

# E-posta (SMTP öncelikli; yoksa Resend) (zorunlu: biri)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Voltekno <info@voltekno.com>"
SMTP_EMAIL=
# Sertifika doğrulamasını kapatmak için false (önerilmez)
SMTP_TLS_REJECT_UNAUTHORIZED=true
RESEND_API_KEY=

# Kart ödemesi — Banka sanal POS (NestPay / Payten 3D Pay Hosting; Ziraat, Türkiye Finans vb.)
# Banka başvurusu onaylanınca verilen bilgiler. Boşsa ödeme sayfasında kart seçilirse "kullanılamıyor" uyarısı çıkar.
# Bankaya bildirilecek dönüş adresi (okUrl / failUrl): https://voltekno.com/api/payments/pos/callback
# Test ortamı: POS_GATEWAY_URL=https://entegrasyon.asseco-see.com.tr/fim/est3Dgate (bankanın verdiği test mağazası ile)
POS_BANK_NAME=
POS_CLIENT_ID=
POS_STORE_KEY=
POS_GATEWAY_URL=
# Yalnızca bankanız önerirse: 3D'ye kayıtlı olmayan kartları (mdStatus 2-4, ters ibrazda sorumluluk satıcıda) kabul et
# POS_ALLOW_HALF_SECURE=true

# PayTR (yalnızca bildirim doğrulaması hazır; ödeme başlatma henüz entegre değil)
# Bildirim URL: https://voltekno.com/api/webhooks/paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# Zamanlanmış görev anahtarı — havale ödeme hatırlatma / süresi dolanları iptal (zorunlu)
# Hostinger cron (ör. 6 saatte bir):
#   curl -s -X POST -H "Authorization: Bearer $CRON_SECRET" https://voltekno.com/api/cron/expire-orders
# (havale hatırlatma/iptal, stok bildirimleri, terk edilen sepet hatırlatması)
CRON_SECRET=

# Navlungo Domestic API — yönetim panelinde "Navlungo'da gönderi oluştur", etiket ve otomatik kargo takibi.
# Üçü de girilmezse özellik kapalı kalır (elle takip numarası girişi çalışmaya devam eder).
# API kullanıcısı: Navlungo paneli > Entegrasyonlar (şifre yalnızca bir kez gösterilir; panel girişi API'de çalışmaz).
# Gönderici adresi: Adres Defteri > Depo Konumları kaydının id'si. QA ve üretim ayrı hesaplardır.
# NAVLUNGO_TEST_MODE: 0 veya false yazılmadıkça QA ortamı (domestic-api-qa) kullanılır.
# Takip: uygulama içi zamanlayıcı 2 saatte bir; elle: POST /api/cron/navlungo-tracking (Bearer CRON_SECRET)
NAVLUNGO_API_USERNAME=
NAVLUNGO_API_PASSWORD=
NAVLUNGO_SENDER_ADDRESS_ID=
NAVLUNGO_TEST_MODE=1
# İsteğe bağlı: 1 = Navlungo en uygun firmayı seçer (varsayılan) ya da anlaşma id'si
# NAVLUNGO_CARRIER_ID=1

# Veritabanı yedeği (SQLite) — POST /api/cron/backup, günde 1 kez. Herkese açık klasör OLMAMALI.
BACKUP_DIR=
BACKUP_KEEP=14

# Bot koruması — Cloudflare Turnstile (boşsa kapalı). İletişim, ürün soru/yorum ve stok bildirimi formları.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ETBİS site doğrulama bağlantısı (ETBİS > Site Doğrulama'daki adres). Doluysa footer'da "ETBİS'e kayıtlıdır" rozeti çıkar.
NEXT_PUBLIC_ETBIS_VERIFY_URL=

# Fatura üzerindeki satıcı bilgileri (boşsa lib/legal/company.ts kullanılır)
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_TAX_ID=
COMPANY_TAX_OFFICE=
COMPANY_PHONE=
COMPANY_EMAIL=

# Dosya depolama (fatura PDF arşivi) — Hostinger yerel klasörü
UPLOAD_BASE_DIR=

# Google Search Console doğrulama (isteğe bağlı)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Statik dışa aktarım derlemesi (yalnızca build:static)
STATIC_EXPORT=false

# Geliver (sipariş takibi): app.geliver.io/apitokens. Girilmezse Geliver takibi kapalı kalır.
# Gönderi Geliver panelinde açılır; sipariş no alanına sitedeki sipariş no yazılırsa saatte bir kendiliğinden bağlanır.
GELIVER_API_TOKEN=
